[
    {etcdgun, [
        {clients, [
            {foo, [{"127.0.0.1", 2379}, {"127.0.0.1", 2479}, {"127.0.0.1", 2579}], #{
                cred => {"root", "123456"},
                membership_check_interval => 5000,
                interceptors => [
                    etcdgun_interceptor_log
                ]
            }}
        ]}
    ]},
    {kernel, [
        {logger_level, debug},
        %% Silent error_logger, to remove simple handler and forbid its output
        {error_logger, silent},
        {logger, [
            {handler, default, logger_std_h, #{
                level => debug,
                formatter => {
                    logger_colorful_formatter, #{
                        colors => #{notice => {bright, cyan}, info => green, warning => {bright, yellow}},
                        template => [
                            time, " [", {'LEVEL', ['LEVEL'], [level]}, "] ", pid, " ",
                            {module, ["[", module, "] "], [{mfa, ["[", mfa, "] "], ""}]},
                            msg,
                            {service, [", service: ", service], ""},
                            {enabled, [", enabled: ", enabled], ""},
                            {interval, [", interval: ", interval], ""},
                            {watch_name, [", watch_name: ", watch_name], ""},
                            "\n"
                        ]
                    }
                },
                filters => [
                    {otp_progress, {fun logger_filters:progress/2, stop}}
                ],
                filter_default => log
            }}
        ]}
    ]}
].
